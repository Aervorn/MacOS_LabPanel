            "state" : "translated",
            "value" : "Page zoom"
          }
        }
      }
    },
    "· téléchargées une fois, puis gardées sur le Mac. En mode sombre, la variante claire est utilisée quand elle existe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
