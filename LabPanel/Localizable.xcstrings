            "value" : "None"
          }
        }
      }
    },
    "Clique, puis tape la combinaison voulue. Échap pour annuler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click, then type the shortcut you want. Esc to cancel."
          }
        }
